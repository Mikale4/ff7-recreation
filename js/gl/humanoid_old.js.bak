  const PROPS = {
    field: { foot: [0.085, 0.055, 0.14], shin: 0.17, thigh: 0.15, legW: 0.09, pelvisH: 0.07, torso: 0.23, torsoW: [0.19, 0.25], torsoD: 0.13,
