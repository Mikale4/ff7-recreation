  C3.variant = function (base, seed) {
    const b = P[base] || P.man;
    const r = U.rng(U.strSeed(base + ':' + seed));
    const pick = (arr) => arr[Math.floor(r() * arr.length)];
    const hairs = ['#201810', '#503018', '#7a4a20', '#a07040', '#d0b060', '#303030', '#8a3018'];
    const tops = ['#6a7a9a', '#9a5a4a', '#5a8a5a', '#8a7a4a', '#7a5a8a', '#4a6a8a', '#a08050', '#607060', '#b07060', '#c0b090'];
    const bots = ['#4a4a5a', '#3a3a3a', '#5a4a38', '#2a3a5a', '#6a5a48'];
    const styles = b.female ? ['long', 'bob', 'ponytail', 'bun'] : ['short', 'slick', 'short', 'buzz', 'bald'];
    const o = Object.assign({}, b, { hair: pick(hairs), top: pick(tops), bottom: pick(bots) });
    o.sleeve = b.sleeve === 'skin' ? 'skin' : o.top;
    if (b.skirt === 'long') o.bottom = o.top;
    if (!b.rig && base !== 'oldman' && base !== 'oldwoman' && base !== 'worker') o.hairStyle = pick(styles);
    if (base === 'oldman' || base === 'oldwoman') o.hair = pick(['#d0d0d0', '#e8e8e8', '#a0a0a0']);
    o.skin = pick(['#f0c8a0', '#f4d0b0', '#e0b088', '#c89070', '#8a5a38']);
    return o;
  };

  function resolve(app) {
    if (!app) return P.man;
    if (typeof app === 'string') {
      if (P[app]) return P[app];
      const m = app.match(/^([a-z_]+?)(\d+)$/);
      if (m && P[m[1]]) return C3.variant(m[1], m[2]);
      return P.man;
    }
    const base = app.base ? resolve(app.base) : P.man;
    return Object.assign({}, base, app);
  }
  C3.resolve = resolve;

